<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EntregaSegura.Views.vDetalleOrden"
             Title="Detalle de la orden">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label x:Name="lblNumero" FontSize="22" FontAttributes="Bold" />
            <Label x:Name="lblCliente" FontSize="18" />
            <Label x:Name="lblEstado" FontAttributes="Bold" />
            <Label x:Name="lblConductor" />

            <Label Text="Cliente:" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label x:Name="lblRuc" />
            <Label Text="Dirección:" FontAttributes="Bold" />
            <Label x:Name="lblDireccion" />
            <Label Text="Teléfono:" FontAttributes="Bold" />
            <Label x:Name="lblTelefono" />

            <Label Text="Productos:" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label x:Name="lblProductos" />
            <Label x:Name="lblUnidades" />
            <Label x:Name="lblTotal" FontAttributes="Bold" />

            <Button x:Name="btnComoLlegar" Text="Cómo llegar (Google Maps)" Clicked="btnComoLlegar_Clicked" Margin="0,10,0,0" />
            <Button x:Name="btnLlamar" Text="Llamar al cliente" Clicked="btnLlamar_Clicked" />
            <Button x:Name="btnEntregar" Text="Confirmar entrega" BackgroundColor="Green" Clicked="btnEntregar_Clicked" />
            <Button x:Name="btnNovedad" Text="No se pudo entregar" BackgroundColor="Red" Clicked="btnNovedad_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
