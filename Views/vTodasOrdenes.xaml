<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modelos="clr-namespace:EntregaSegura.Models"
             x:Class="EntregaSegura.Views.vTodasOrdenes"
             Title="Todas las órdenes">
    <Grid RowDefinitions="Auto,Auto,*" Padding="15" RowSpacing="8">

        <Picker x:Name="pkFiltro" Title="Filtrar por estado" SelectedIndexChanged="pkFiltro_SelectedIndexChanged">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Todas</x:String>
                    <x:String>Pendientes</x:String>
                    <x:String>Entregadas</x:String>
                    <x:String>Con novedad</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>
        <Label x:Name="lblCantidad" Grid.Row="1" />

        <RefreshView x:Name="refrescar" Grid.Row="2" Refreshing="refrescar_Refreshing">
            <CollectionView x:Name="lstOrdenes" SelectionMode="Single" SelectionChanged="lstOrdenes_SelectionChanged">
                <CollectionView.EmptyView>
                    <Label Text="No hay órdenes con este filtro." HorizontalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="modelos:Orden">
                        <VerticalStackLayout Padding="5,8">
                            <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding ConductorTexto}" />
                            <Label Text="{Binding Resumen}" FontSize="13" />
                            <Label Text="{Binding EstadoTexto}" TextColor="{Binding ColorEstado}" />
                            <BoxView HeightRequest="1" Color="LightGray" Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
