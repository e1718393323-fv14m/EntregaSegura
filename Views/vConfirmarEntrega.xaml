<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="EntregaSegura.Views.vConfirmarEntrega"
             Title="Confirmar entrega">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label x:Name="lblOrden" FontSize="18" FontAttributes="Bold" />

            <Label Text="Nombre de quien recibe:" />
            <Entry x:Name="txtRecibe" Placeholder="Nombres y apellidos" MaxLength="60" TextChanged="txtRecibe_TextChanged" />

            <!-- Sensor 1: CÁMARA -->
            <Label Text="Foto de la entrega:" Margin="0,10,0,0" />
            <Label x:Name="lblSinFoto" Text="(sin foto)" />
            <Image x:Name="imgFoto" HeightRequest="180" Aspect="AspectFit" />
            <Button x:Name="btnFoto" Text="Tomar foto" Clicked="btnFoto_Clicked" />

            <!-- Sensor 3: PANTALLA TÁCTIL (firma) -->
            <Label Text="Firma del cliente:" Margin="0,10,0,0" />
            <toolkit:DrawingView x:Name="drwFirma"
                                 HeightRequest="160"
                                 LineColor="Black"
                                 LineWidth="4"
                                 IsMultiLineModeEnabled="True"
                                 ShouldClearOnFinish="False"
                                 BackgroundColor="LightGray"
                                 DrawingLineCompleted="drwFirma_DrawingLineCompleted" />
            <Button x:Name="btnBorrarFirma" Text="Borrar firma" BackgroundColor="Gray" Clicked="btnBorrarFirma_Clicked" />

            <!-- Sensor 2: GPS -->
            <Label x:Name="lblUbicacion" Text="Ubicación: sin leer" Margin="0,10,0,0" />
            <Button x:Name="btnUbicacion" Text="Leer ubicación GPS" Clicked="btnUbicacion_Clicked" />

            <HorizontalStackLayout>
                <CheckBox x:Name="chkConforme" CheckedChanged="chkConforme_CheckedChanged" />
                <Label Text="El cliente recibe conforme" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Se actualiza mientras el usuario completa los datos -->
            <Label Text="Antes de guardar:" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label x:Name="lblChecklist" />

            <Button x:Name="btnGuardar" Text="Guardar entrega" BackgroundColor="Green" IsEnabled="False" Clicked="btnGuardar_Clicked" />
            <ActivityIndicator x:Name="indicador" IsRunning="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
