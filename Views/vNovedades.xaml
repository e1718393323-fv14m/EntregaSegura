<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modelos="clr-namespace:EntregaSegura.Models"
             x:Class="EntregaSegura.Views.vNovedades"
             Title="Novedades">
    <Grid RowDefinitions="Auto,*" Padding="15" RowSpacing="8">
        <Label Text="Toque una novedad pendiente para revisarla." />

        <RefreshView x:Name="refrescar" Grid.Row="1" Refreshing="refrescar_Refreshing">
            <CollectionView x:Name="lstNovedades" SelectionMode="Single" SelectionChanged="lstNovedades_SelectionChanged">
                <CollectionView.EmptyView>
                    <Label Text="No hay novedades registradas." HorizontalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="modelos:Novedad">
                        <VerticalStackLayout Padding="5,8">
                            <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Detalle}" />
                            <Label Text="{Binding Info}" FontSize="12" />
                            <Label Text="{Binding EstadoTexto}" TextColor="{Binding ColorEstado}" />
                            <BoxView HeightRequest="1" Color="LightGray" Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
