<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EntregaSegura.Views.vSupervisor"
             Title="Menú supervisor"
             NavigationPage.HasBackButton="False">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Image Source="logo.png" WidthRequest="80" />
            <Label x:Name="lblSaludo" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Rol: Supervisor" HorizontalOptions="Center" />
            <Label x:Name="lblFecha" HorizontalOptions="Center" />

            <Label Text="Resumen del equipo" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label x:Name="lblTotal" Text="Órdenes: -" />
            <Label x:Name="lblPendientes" Text="Pendientes: -" />
            <Label x:Name="lblEntregadas" Text="Entregadas: -" TextColor="Green" />
            <Label x:Name="lblNovedades" Text="Con novedad: -" TextColor="Red" />
            <Label x:Name="lblPorRevisar" Text="Novedades por revisar: -" FontAttributes="Bold" />
            <ProgressBar x:Name="barAvance" Progress="0" />
            <Label x:Name="lblAvance" Text="Avance: 0 %" HorizontalOptions="End" />

            <Button x:Name="btnOrdenes" Text="Todas las órdenes" Clicked="btnOrdenes_Clicked" />
            <Button x:Name="btnNovedades" Text="Revisar novedades" BackgroundColor="Red" Clicked="btnNovedades_Clicked" />
            <Button x:Name="btnPerfil" Text="Mi perfil" Clicked="btnPerfil_Clicked" />
            <Button x:Name="btnSalir" Text="Cerrar sesión" BackgroundColor="Gray" Clicked="btnSalir_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
