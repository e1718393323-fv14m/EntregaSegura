<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EntregaSegura.Views.vPrincipal"
             Title="Menú principal"
             NavigationPage.HasBackButton="False">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Image Source="logo.png" WidthRequest="80" />
            <Label x:Name="lblSaludo" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label x:Name="lblFecha" HorizontalOptions="Center" />
            <Label x:Name="lblVehiculo" HorizontalOptions="Center" />

            <Label Text="Resumen del día" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label x:Name="lblPendientes" Text="Pendientes: -" />
            <Label x:Name="lblRealizadas" Text="Realizadas: -" />

            <Button x:Name="btnEntregas" Text="Mis entregas" Clicked="btnEntregas_Clicked" />
            <Button x:Name="btnHistorial" Text="Historial" Clicked="btnHistorial_Clicked" />
            <Button x:Name="btnPerfil" Text="Mi perfil" Clicked="btnPerfil_Clicked" />
            <Button x:Name="btnSalir" Text="Cerrar sesión" BackgroundColor="Gray" Clicked="btnSalir_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
